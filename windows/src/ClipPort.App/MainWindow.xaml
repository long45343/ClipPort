<ui:FluentWindow x:Class="ClipPort.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:tray="http://schemas.lepo.co/wpfui/2022/xaml/tray"
        Title="ClipPort" Height="640" Width="720"
        MinHeight="500" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Icon="pack://application:,,,/app.ico">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Modern Fluent TitleBar -->
        <ui:TitleBar Title="ClipPort" Grid.Row="0" Icon="pack://application:,,,/app.ico" CloseWindowByDoubleClickOnIcon="False" />

        <!-- Native WPF-UI TrayIcon -->
        <tray:NotifyIcon
            x:Name="RootNotifyIcon"
            FocusOnLeftClick="True"
            Icon="pack://application:,,,/app.ico"
            MenuOnRightClick="True"
            TooltipText="ClipPort"
            LeftClick="RootNotifyIcon_LeftClick">
            <tray:NotifyIcon.Menu>
                <ContextMenu>
                    <MenuItem Header="打开主窗口" Click="OpenMenuItem_Click" />
                    <MenuItem x:Name="TraySyncMenuItem" Header="剪贴板同步" IsCheckable="True" IsChecked="True" Click="SyncMenuItem_Click" />
                    <Separator />
                    <MenuItem Header="退出" Click="ExitMenuItem_Click" />
                </ContextMenu>
            </tray:NotifyIcon.Menu>
        </tray:NotifyIcon>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20,10,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Status & Local IPs Card -->
            <ui:Card Grid.Row="0" Margin="0,0,0,12" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ui:TextBlock Text="状态: " FontWeight="SemiBold" />
                            <ui:TextBlock x:Name="StatusText" Text="未配对" />
                        </StackPanel>
                        <ui:TextBlock x:Name="LocalIpText" Text="本机地址: 获取中…" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:ToggleSwitch x:Name="AutoStartToggle" Content="开机自启" Margin="0,0,16,0" Click="AutoStartToggle_Click" />
                        <ui:ToggleSwitch x:Name="SyncToggle" Content="同步" IsChecked="True" Click="SyncToggle_Click" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- Pairing Card -->
            <ui:Card Grid.Row="1" Margin="0,0,0,12" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                            <ui:Button x:Name="PairBtn" Content="开始配对" Appearance="Primary" Click="PairBtn_Click" Margin="0,0,16,0" />
                            <ui:TextBlock x:Name="PairCodeText" Text="" FontTypography="TitleLarge" FontWeight="Bold" Margin="0,0,16,0" />
                        </StackPanel>
                        <ui:TextBlock x:Name="PairHintText" Text="点击「开始配对」生成 6 位配对码及手机扫码互联二维码" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border x:Name="QrBorder" Grid.Column="1" Visibility="Collapsed" Background="White" CornerRadius="8" Padding="6" Margin="16,0,0,0">
                        <Image x:Name="QrImage" Width="108" Height="108" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Border>
                </Grid>
            </ui:Card>

            <!-- Connect Other Devices Section -->
            <ui:Card Grid.Row="2" Margin="0,0,0,12" Padding="16">
                <StackPanel>
                    <ui:TextBlock Text="连接对端设备（对端需先点「开始配对」开启窗口）" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBox x:Name="PeerHostBox" PlaceholderText="对端 IP" Width="180" Margin="0,0,8,0" />
                        <ui:TextBox x:Name="PeerPortBox" PlaceholderText="端口" Text="47190" Width="80" Margin="0,0,8,0" />
                        <ui:TextBox x:Name="PeerCodeBox" PlaceholderText="配对码(可选)" Width="120" Margin="0,0,8,0" />
                        <ui:Button Content="连接" Appearance="Secondary" Click="ConnectPeer_Click" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- File Share Card (D-26=A) -->
            <ui:Card Grid.Row="3" Margin="0,0,0,12" Padding="14" AllowDrop="True" Drop="FileDrop_Drop" DragOver="FileDrop_DragOver">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <ui:TextBlock Text="文件共享（拖拽文件至此直接推发给在线设备）" FontWeight="SemiBold" />
                        <ui:TextBlock Text="接收文件自动保存至系统「下载/ClipPort」目录" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
                    </StackPanel>
                    <ui:Button Grid.Column="1" Content="选择文件发送…" Appearance="Secondary" Click="SendFileBtn_Click" />
                </Grid>
            </ui:Card>

            <!-- Log Header -->
            <ui:TextBlock Grid.Row="4" Text="运行日志" FontWeight="SemiBold" Margin="0,0,0,6" />

            <!-- Log ListView -->
            <ui:ListView x:Name="LogList" Grid.Row="5" SelectionMode="Single" />
        </Grid>
    </Grid>
</ui:FluentWindow>
