<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ClipPort.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ClipPort">
    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="ClipPort" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock x:Name="LocalIpText" Text="" Opacity="0.7"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <TextBlock x:Name="StatusText" Text="未配对" VerticalAlignment="Center"/>
            <ToggleSwitch x:Name="SyncToggle" OnContent="同步开" OffContent="同步关"
                          IsOn="True" Toggled="SyncToggle_Toggled"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
            <Button x:Name="PairBtn" Content="开始配对" Click="PairBtn_Click"/>
            <TextBlock x:Name="PairCodeText" Text="" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Grid.Row="3" Text="日志"/>
        <ListView x:Name="LogList" Grid.Row="4" SelectionMode="None"/>
    </Grid>
</Window>
